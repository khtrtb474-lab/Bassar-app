<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تطبيق بصير — المساعد الذكي"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:contentDescription="تطبيق بصير المساعد الذكي" />

        <Button
            android:id="@+id/btnStartHelp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="ابدأ المساعدة"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"
            android:contentDescription="زر ابدأ المساعدة" />

        <Button
            android:id="@+id/btnWhatIsFront"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="ماذا يوجد أمامي؟"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:contentDescription="زر ماذا يوجد أمامي" />

        <Button
            android:id="@+id/btnGoToPlace"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="أريد الذهاب إلى مكان"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:contentDescription="زر أريد الذهاب إلى مكان" />

        <Button
            android:id="@+id/btnWhereAmI"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="أين أنا؟"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:contentDescription="زر أين أنا" />

        <Button
            android:id="@+id/btnSavedPlaces"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="الوجهات المحفوظة"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:contentDescription="زر الوجهات المحفوظة" />

        <Button
            android:id="@+id/btnStopHelp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="إيقاف المساعدة"
            android:textSize="18sp"
            android:backgroundTint="#B22222"
            android:textColor="#FFFFFF"
            android:contentDescription="زر إيقاف المساعدة" />

    </LinearLayout>
</ScrollView>
